{
  "name": "swap-tower-proto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:artifact": "npm run build && node scripts/make-artifact.mjs",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.js --log-level=warning",
    "build:all": "vite build && npm run build:server",
    "start": "node dist-server/index.js",
    "dev:server": "npm run build:server && PORT=8787 node dist-server/index.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
